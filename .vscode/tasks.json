{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Django Backend",
      "type": "shell",
      "command": "python backend/manage.py runserver",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "agrirent",
        "reveal": "always",
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Vite Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "agrirent",
        "reveal": "always",
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start AgriRent AI (Full Stack)",
      "dependsOn": [
        "Run Django Backend",
        "Run Vite Frontend"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
