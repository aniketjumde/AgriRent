# AgriRent Frontend Environment Variables (Vercel & Local)

# Production Django REST Backend URL (e.g., https://agrirent-api.onrender.com or empty if using reverse proxy)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase Managed Backend Settings (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_SUPABASE_STORAGE_BUCKET=equipment-images
