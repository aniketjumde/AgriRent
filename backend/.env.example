# AgriRent Local / Production Environment Configuration Template
# NOTE: Never commit sensitive credentials to source control.

# Django Security
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-for-local-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration:
# Leave DATABASE_URL empty to use default local SQLite (db.sqlite3)
# Or configure local PostgreSQL:
# DATABASE_URL=postgresql://agrirent_user:agrirent_pass@localhost:5432/agrirent
CONN_MAX_AGE=600

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Email Service Configuration (Defaults to console backend in DEBUG)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AgriRent Support <noreply@agrirent.local>

# Frontend URL for Verification & Password Reset Links
FRONTEND_URL=http://localhost:5173

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_AgriRentDemoKey123
RAZORPAY_KEY_SECRET=AgriRentDemoKeySecretXYZ456
RAZORPAY_WEBHOOK_SECRET=whsec_AgriRentTestWebhook789
