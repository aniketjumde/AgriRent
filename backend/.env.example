# AgriRent Secure Production Environment Configuration Template
# NOTE: Never commit sensitive credentials to source control.

# Django Security
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-50-character-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,agrirent-frontend-sandy.vercel.app

# Database: Supabase PostgreSQL connection
DATABASE_URL=postgresql://postgres.yourprojectref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Alternative discrete DB parameters
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-secure-password
# DB_HOST=db.yourprojectref.supabase.co
# DB_PORT=5432
# DB_SSLMODE=require
CONN_MAX_AGE=600

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=https://agrirent-frontend-sandy.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://agrirent-frontend-sandy.vercel.app,http://localhost:5173

# Email Service Configuration (SendGrid / AWS SES / Mailgun / SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key-here
DEFAULT_FROM_EMAIL=AgriRent Security <noreply@agrirent.com>

# Frontend URL for Verification & Password Reset Links
FRONTEND_URL=https://agrirent-frontend-sandy.vercel.app

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_live_or_test_key_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder

# Supabase Storage & Client API
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_STORAGE_BUCKET=equipment-images
