# AgriRent Backend Environment Variables (Production & Local)

# Django Core
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,agrirent-api.onrender.com,.vercel.app

# Database: Supabase PostgreSQL Connection String (Project Settings -> Database -> Connection string -> URI)
# Use Transaction Pooler (port 6543) or Direct (port 5432) with sslmode=require
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# CORS & CSRF Origins (Allow your Vercel deployment frontend)
CORS_ALLOWED_ORIGINS=https://agrirent.vercel.app,https://your-custom-domain.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://agrirent.vercel.app,https://*.vercel.app

# Supabase API & Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-private-key
SUPABASE_STORAGE_BUCKET=equipment-images

# Razorpay Test Gateway (Optional)
RAZORPAY_KEY_ID=rzp_test_AgriRentDemoKey123
RAZORPAY_KEY_SECRET=AgriRentDemoKeySecretXYZ456
RAZORPAY_WEBHOOK_SECRET=whsec_AgriRentTestWebhook789
